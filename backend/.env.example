# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres. Neon and other managed providers require sslmode=require.
DATABASE_URL=postgresql://user@localhost:5432/kelana

# Bedrock. AWS_REGION is read at import time — the app will not start without it.
AWS_REGION=ap-southeast-2
MODEL_ID=amazon.nova-lite-v1:0
AWS_BEARER_TOKEN_BEDROCK=

# Signs session tokens. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# The /assistant feature only. The bearer token above does not authorize the
# Knowledge Base APIs, so these SigV4 credentials are required separately.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KNOWLEDGE_BASE_ID=

# Destination photos. Unset means the lookup is skipped and trips are simply
# created without an image. Get a key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Deployments only: extra CORS origins, comma-separated. Vercel's own
# *.vercel.app hostnames are matched by a regex in main.py and need no entry.
FRONTEND_URL=
